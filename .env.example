# Environment Variables
# Copy this file to .env and fill in your values

VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# URL of the deployed Cloudflare Worker proxy (never put the OpenRouter key here)
# e.g. https://rameez-node-proxy.YOUR_SUBDOMAIN.workers.dev
VITE_NODE_PROXY_URL=
